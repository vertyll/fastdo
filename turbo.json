{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "build/**",
        "dist/**"
      ],
      "cache": true,
      "persistent": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "cache": true,
      "persistent": false
    },
    "format": {
      "dependsOn": [
        "^format"
      ],
      "cache": true,
      "persistent": false
    },
    "format:check": {
      "dependsOn": [
        "^format:check"
      ],
      "cache": true,
      "persistent": false
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "cache": true,
      "persistent": false
    },
    "test:watch": {
      "dependsOn": [
        "^test:watch"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
